POSTHOG_KEY=

# Optional — override the PostHog host. 
# POSTHOG_HOST=

#Supabase
DATABASE_URL=

# ─── NOWPayments ────────────────────────────────────────────────────────────
# Dashboard: https://account-sandbox.nowpayments.io  (sandbox — use this for dev)
#            https://account.nowpayments.io           (production)
# Base URL must match the dashboard where you created the API key.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_SUCCESS_URL=http://localhost:8080/orders/{orderId}?result=success
NOWPAYMENTS_CANCEL_URL=http://localhost:8080/orders/{orderId}?result=cancel
# Public URL NOWPayments POSTs IPN callbacks to.
# Local dev: run `ngrok http 8080` and paste the public HTTPS URL + /webhooks/nowpayments
NOWPAYMENTS_IPN_CALLBACK_URL=
